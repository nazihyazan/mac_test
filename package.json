{
  "name": "floatboard",
  "version": "1.0.18",
  "description": "A fast floating clipboard and notes manager",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron .",
    "build:linux": "electron-builder --linux --publish never -c.directories.output=dist/linux",
    "build:snap": "electron-builder --linux snap --publish never -c.directories.output=dist/linux",
    "build:win": "electron-builder --win nsis --x64 --publish never -c.directories.output=dist/windows",
    "build:store": "electron-builder --win appx --x64 --publish never -c.directories.output=dist/windows-store",
    "test:win": "node scripts/windows-health-smoke.cjs",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node scripts/smoke-test.cjs",
    "test:snap": "node scripts/check-snap.cjs"
  },
  "keywords": [
    "clipboard",
    "floating",
    "electron",
    "productivity"
  ],
  "author": "Nazih <nazih@example.com>",
  "homepage": "https://github.com/nazih/floating-board",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.1.8",
    "koffi": "^3.0.0",
    "node-machine-id": "^1.1.12",
    "x11": "4.2.1"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "playwright": "^1.44.0"
  },
  "build": {
    "appId": "com.nazih.floatboard",
    "buildVersion": "1.0.18.0",
    "productName": "FloatBoard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "window-state.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "upgrade.css",
      "license.js",
      "seo.js",
      "assets/**/*",
      "clipboard-watcher.js",
      "media-store.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "FloatBoard-${version}-windows-${arch}.${ext}"
    },
    "appx": {
      "identityName": "FloatingToolsStudio.FloatBoard",
      "applicationId": "FloatBoard",
      "publisher": "CN=A59290A1-B053-4A32-B868-B3EC2BD33ABF",
      "publisherDisplayName": "Floating Tools Studio",
      "displayName": "FloatBoard",
      "artifactName": "FloatBoard-${version}-store-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "snap"
      ],
      "category": "Utility;Office;TextTools;",
      "executableName": "floatboard",
      "artifactName": "FloatBoard-${version}-linux.${ext}",
      "icon": "build/icon.png",
      "synopsis": "A floating clipboard manager for Linux.",
      "description": "FloatBoard is a fast, unobtrusive floating clipboard manager designed for productivity. Easily store, organize, and paste your clipboard history."
    },
    "snap": {
      "summary": "Floating clipboard manager",
      "description": "FloatBoard is a productivity-focused, floating clipboard manager that allows you to easily store, organize, and paste your clipboard history directly from a clean, unobtrusive floating overlay. Designed for speed and efficiency.",
      "confinement": "strict",
      "grade": "stable",
      "plugs": [
        "desktop",
        "desktop-legacy",
        "home",
        "x11",
        "wayland",
        "unity7",
        "browser-support",
        "network",
        "gsettings",
        "audio-playback",
        "opengl"
      ]
    }
  }
}
